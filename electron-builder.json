{
  "appId": "com.booklib.app",
  "productName": "BookLib",
  "directories": {
    "output": "dist-packaged"
  },
  "asar": true,
  "files": [
    "dist-electron/**/*",
    ".output/public/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "compression": "normal",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BookLib",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png",
    "category": "Office",
    "maintainer": "Jessica Aissa <deadalley31@gmail.com>",
    "vendor": "Jessica Aissa",
    "description": "BookLib is an application for managing your book collection.",
    "synopsis": "Manage your personal book library",
    "desktop": {
      "entry": {
        "Name": "BookLib",
        "Comment": "Manage your personal book library",
        "Keywords": "books;library;reading;collection;",
        "StartupWMClass": "booklib",
        "Categories": "Office;Education;",
        "StartupNotify": "true"
      }
    },
    "executableName": "booklib",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "deb": {
    "packageName": "booklib",
    "packageCategory": "utils",
    "priority": "optional",
    "description": "BookLib is an application for managing your book collection.",
    "synopsis": "Manage your personal book library",
    "maintainer": "Jessica Aissa <deadalley31@gmail.com>",
    "vendor": "Jessica Aissa",
    "artifactName": "booklib_${version}_${arch}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "deadalley",
    "repo": "booklib-app"
  },
  "npmRebuild": false,
  "copyright": "Copyright © 2025 Jessica Aissa"
}
